# ============================================================
# 主機 logrotate 設定 — WMS nginx 容器日誌（./logs/nginx/*.log）
#
# 背景：nginx 容器的 access_log / error_log 透過 bind mount
# （docker-compose.nginx.yml：./logs/nginx:/var/log/nginx）直接寫到
# 主機檔案系統，不經過 Docker 的 json-file log driver，因此
# docker-compose.*.yml 新增的 logging.options.max-size 對這些檔案
# 不生效，需要主機 logrotate 另外控管，否則長期執行會無限增長。
#
# 用 copytruncate：不需要訊號通知 nginx 重開檔案，容器內程序持有的
# fd 對已 truncate 的檔案繼續寫入即可，避免額外操作容器的複雜度。
#
# ── 使用方式 ─────────────────────────────────────────────────
#   1. 搜尋取代：/opt/wms → 專案根目錄（與 conf/nginx/host/*.conf 一致）
#   2. sudo cp conf/logrotate/wms-nginx /etc/logrotate.d/wms-nginx
#   3. sudo logrotate -d /etc/logrotate.d/wms-nginx   # 先跑一次 dry-run 確認語法
# ============================================================

/opt/wms/logs/nginx/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    maxsize 10M
}
